includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: 5

    # Larastan reads model properties from the migrations; setting this replaces its default path.
    databaseMigrationsPath:
        - database/migrations
        - app/Travel/Database/Migrations

    ignoreErrors:
        -
            identifier: rules.modelAppends
